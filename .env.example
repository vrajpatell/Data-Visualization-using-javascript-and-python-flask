USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
CACHE_TTL_SECONDS=300
SQLITE_DB_PATH=data/earthquakes.db
DEFAULT_FEED_WINDOW=day
MODEL_PATH=models/earthquake_risk.joblib
ENABLE_BOOTSTRAP_DATA=true
ENABLE_MODEL_TRAINING_ON_STARTUP=false
MAX_API_LIMIT=2000
ADMIN_TOKEN=change-me-for-admin-training
